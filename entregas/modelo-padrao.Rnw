<<setup, include=FALSE>>=
library(knitr)
opts_chunk$set(
  echo       = FALSE,   # o codigo NAO aparece: ele mora em estrutura/codigo/
  message    = FALSE,
  warning    = FALSE,
  fig.align  = "center",
  out.width  = "0.52\\linewidth",
  fig.width  = 4,
  fig.height = 4
)
options(OutDec = ",", digits = 4)
@

<<dados, include=FALSE>>=
# ============================================================================================================================================
dados    <- read.csv("dados-enem-2021-2025.csv")
resposta <- "RACA"
# =========================================================================

# REGRA: nada de acento dentro de string de R -- o acento quebra quando a
# sessao do R nao esta em locale UTF-8. Onde precisar, escreva o acento em
# LaTeX ("m\\'edia", "regress\\~ao"): o \Sexpr repassa intacto.
tex <- function(x) gsub("_", "\\\\_", x)   # protege o sublinhado dos nomes

y            <- dados[[resposta]]
quantitativa <- is.numeric(y)
n            <- nrow(dados)
p            <- ncol(dados) - 1
resposta_tex <- tex(resposta)

# --- linha de base: o desempenho do palpite mais burro possivel ----------
if (quantitativa) {
  valor_base       <- sd(y, na.rm = TRUE)
  texto_base       <- paste0("RMSE = ", format(round(valor_base, 2), nsmall = 2))
  nome_base        <- "chutar sempre a m\\'edia"
  palavra_tipo     <- "regress\\~ao"
  palavra_resposta <- "quantitativa"
  palavra_metrica  <- "RMSE, na unidade de $Y$"
} else {
  valor_base       <- max(table(y)) / sum(table(y))
  texto_base       <- paste0("acur\\'acia = ", format(round(valor_base, 3), nsmall = 3))
  nome_base        <- "chutar a classe mais comum"
  palavra_tipo     <- "classifica\\c{c}\\~ao"
  palavra_resposta <- "qualitativa"
  palavra_metrica  <- "acur\\'acia ou AUC"
}

# --- suspeita de vazamento: quem mais se parece com a resposta -----------
num <- dados[sapply(dados, is.numeric)]
if (quantitativa && ncol(num) > 1) {
  cc <- abs(cor(num, use = "complete.obs")[, resposta])
  cc <- sort(cc[names(cc) != resposta], decreasing = TRUE)
  texto_cor <- paste0("\\texttt{", tex(names(cc)[1]), "}: ",
                      format(round(cc[1], 3), nsmall = 3))
} else {
  texto_cor <- "n\\~ao se aplica (resposta qualitativa)"
}

# --- balanco das classes e valores faltantes -----------------------------
if (quantitativa) {
  texto_balanco <- "n\\~ao se aplica (resposta quantitativa)"
} else {
  texto_balanco <- paste(
    paste0(
      "\\texttt{",
      tex(names(table(y))),
      "}: ",
      as.integer(table(y))
    ),
    collapse = " | "
  )
}

faltantes <- colSums(is.na(dados))

texto_falta <- if (sum(faltantes) == 0) {
  "nenhum"
} else {
  paste(
    paste0(
      "\\texttt{",
      tex(names(faltantes)[faltantes > 0]),
      "}: ",
      faltantes[faltantes > 0]
    ),
    collapse = " | "
  )
}
@

